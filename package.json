{
    "name": "skladno",
    "private": true,
    "version": "0.7.1",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently --kill-others -n server,web -c blue,green \"npm run dev --workspace @skladno/server\" \"npm run dev --workspace @skladno/web\"",
        "dev:site": "npm run docs:build && vite site --host 127.0.0.1 --config site/vite.config.mjs",
        "docs:dev": "node scripts/copy-site-assets.mjs && vitepress dev site/user-docs",
        "docs:build": "node scripts/copy-site-assets.mjs && vitepress build site/user-docs",
        "build:site": "npm run docs:build && vite build site --config site/vite.config.mjs",
        "check:site": "node scripts/check-site-metadata.mjs",
        "dev:electron": "npm run build --workspace @skladno/electron && concurrently --kill-others-on-fail -n web,electron -c green,blue \"node scripts/start-electron-web.mjs\" \"npm run start --workspace @skladno/electron\"",
        "package:electron": "npm run package --workspace @skladno/electron",
        "make:electron": "npm run make --workspace @skladno/electron",
        "make:electron:linux": "npm run make:linux --workspace @skladno/electron",
        "lint": "node scripts/check-line-length.mjs && node scripts/web-import-boundaries.mjs && eslint . --max-warnings 0 && node scripts/check-data-properties.mjs",
        "lint:fix": "eslint . --fix --max-warnings 0",
        "complexity:check": "node scripts/complexity-check.mjs",
        "typecheck": "tsc -b",
        "product:check": "node scripts/product-model.mjs check",
        "product:docs": "node scripts/product-model.mjs generate",
        "product:impact": "node scripts/product-model.mjs impact",
        "release": "node scripts/release.mjs stable",
        "release:preview": "node scripts/release.mjs preview",
        "verify:core": "node scripts/verify-core.mjs",
        "verify:pr": "node scripts/verify-pr.mjs",
        "verify:browser": "playwright test",
        "verify:desktop": "playwright test --config playwright.electron.config.ts",
        "build": "npm run build --workspaces --if-present && npm run lint",
        "test": "node --test scripts/*.test.mjs && npm run test --workspaces --if-present"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22.10.2",
        "ajv": "^8.20.0",
        "concurrently": "^9.1.0",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.3.0",
        "posthog-js": "^1.438.12",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.65.0",
        "vitepress": "^1.6.4"
    }
}
