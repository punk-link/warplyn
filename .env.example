# Optional for AI operations. This value is read only by the local service.
# It is deliberately not prefixed with VITE_ and is never available to browser code.
WARPLYN_AI_API_KEY=
WARPLYN_AI_MODEL=gpt-5

# Disabled by default. Set true only if you accept your AI provider retaining
# response state to connect eligible editorial requests for the same Article.
# Other Articles, fact checks, and translations always start fresh.
WARPLYN_AI_SESSION_CONTINUATION=false

# The local service listens only on loopback by default.
WARPLYN_SERVER_HOST=127.0.0.1
WARPLYN_SERVER_PORT=8787

# Origin permitted to make development browser requests to the local service.
WARPLYN_WEB_ORIGIN=http://localhost:5173

# Optional: separate live data folder. Never use a Skladno data directory.
# WARPLYN_DATA_DIR=
